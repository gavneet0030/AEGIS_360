AEGIS_ENV=development
AEGIS_LOG_LEVEL=INFO
AEGIS_DATA_DIR=data/runtime
AEGIS_MAX_UPLOAD_MB=25
# Use password for local/restricted deployments or oidc with an identity allowlist.
AEGIS_AUTH_MODE=password
AEGIS_ACCESS_PASSWORD=
AEGIS_OIDC_ALLOWED_DOMAINS=
AEGIS_OIDC_ALLOWED_EMAILS=
# Optional mounted Streamlit OIDC secrets file (never commit the real file).
AEGIS_STREAMLIT_SECRETS_FILE=
